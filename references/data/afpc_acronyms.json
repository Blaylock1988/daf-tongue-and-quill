  "abbreviations": {
    "approx": {"meaning": "approximately", "formal_allowed": false, "verb_capable": false, "note": "Avoid in formal memos; spell out 'approximately' or 'about'."},
    "Atch": {"meaning": "Attachment (attachment marker only, e.g., Atch 1)", "formal_allowed": true, "verb_capable": false, "note": "Valid for attachment page markings and parenthetical citations; 'Attachment:'/'Attachments:' spelled out in closing block."},
    "b/w": {"meaning": "between", "formal_allowed": false, "verb_capable": false, "note": "Telegraphic shorthand only (BBP/slides/bullets); never use in formal memo prose."},
    "comm": {"meaning": "commercial telephone", "formal_allowed": true, "verb_capable": false, "note": "Standard in POC lines alongside DSN."},
    "coord": {"meaning": "coordinate / coordination", "formal_allowed": false, "verb_capable": true, "note": "Permitted in SSS coordination column and informal bullets; spell out in formal prose."},
    "dept": {"meaning": "department", "formal_allowed": false, "verb_capable": false, "note": "Spell out in formal prose."},
    "e.g.": {"meaning": "for example (exempli gratia)", "formal_allowed": true, "verb_capable": false, "note": "Follow with a comma in American usage."},
    "etc.": {"meaning": "and so forth (et cetera)", "formal_allowed": true, "verb_capable": false, "note": "Use sparingly; prefer complete specifics in formal staff work."},
    "ft": {"meaning": "foot / feet", "formal_allowed": true, "verb_capable": false, "note": "Use with numerals (e.g., 50 ft)."},
    "gov": {"meaning": "government", "formal_allowed": false, "verb_capable": false, "note": "AFH 33-337 p. 334 prefers shortest form 'gov' over 'gov't' in informal tables; spell out in formal correspondence."},
    "hr": {"meaning": "hour", "formal_allowed": false, "verb_capable": false, "note": "Spell out 'hour' in formal correspondence."},
    "hrs": {"meaning": "hours", "formal_allowed": false, "verb_capable": false, "note": "Telegraphic/bullet usage only; never write '0800 hours' or '0800 hrs' for clock time (p. 358)."},
    "hq": {"meaning": "headquarters", "formal_allowed": true, "verb_capable": false, "note": "As HQ in address elements and MAJCOM/HAF office symbols."},
    "i.e.": {"meaning": "that is (id est)", "formal_allowed": true, "verb_capable": false, "note": "Follow with a comma."},
    "in.": {"meaning": "inch / inches", "formal_allowed": true, "verb_capable": false, "note": "Keep period to prevent confusion with preposition 'in' (p. 334)."},
    "lb": {"meaning": "pound", "formal_allowed": true, "verb_capable": false, "note": "Same form for singular and plural in scientific/technical use (50 lb, p. 334)."},
    "ltr": {"meaning": "letter", "formal_allowed": false, "verb_capable": false, "note": "Informal/recordkeeping abbreviation only (plural: ltrs)."},
    "mi": {"meaning": "mile / miles", "formal_allowed": true, "verb_capable": false, "note": "No period (e.g., 3 mi)."},
    "min": {"meaning": "minute / minimum", "formal_allowed": false, "verb_capable": false, "note": "Spell out in formal prose."},
    "mph": {"meaning": "miles per hour", "formal_allowed": true, "verb_capable": false, "note": "No periods; lowercase."},
    "no.": {"meaning": "number", "formal_allowed": true, "verb_capable": false, "note": "Keep period to prevent confusion with word 'no' (p. 334)."},
    "temp": {"meaning": "temporary / temperature", "formal_allowed": false, "verb_capable": false, "note": "Spell out in formal prose."},
    "w/": {"meaning": "with", "formal_allowed": false, "verb_capable": false, "note": "Telegraphic/bullet shorthand only; spell out 'with' in formal memos and letters."},
    "w/in": {"meaning": "within", "formal_allowed": false, "verb_capable": false, "note": "Telegraphic/bullet shorthand only; spell out in formal prose."},
    "w/o": {"meaning": "without", "formal_allowed": false, "verb_capable": false, "note": "Permitted in 'wo/Atch' closing notation or informal bullets; spell out in formal prose."}
  },
